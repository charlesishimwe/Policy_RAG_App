        lines.extend([f"## {heading}", "", body, ""])

    lines.extend([
        "## Related guidance",
        "",
        "For a real organization, consult the approved policy owner, current procedures, applicable employment terms, and governing law. If this example does not contain the answer to a question, the RAG assistant should say that the available evidence is insufficient.",
        "",
    ])

    (POLICY_DIR / filename).write_text(
